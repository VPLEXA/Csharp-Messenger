<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MessengerClient.ViewModels"
             x:Class="MessengerClient.Views.ForgotPasswordView"
             x:DataType="vm:ForgotPasswordViewModel">
    
    <Grid Background="#F5F5F5">
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="10"
                BoxShadow="0 4 6 0 #00000020"
                Padding="40"
                MinWidth="400"
                MaxWidth="450">
            <StackPanel Spacing="20">
                <!-- Заголовок -->
                <TextBlock Text="Восстановление пароля" 
                          FontSize="28" 
                          FontWeight="Bold" 
                          HorizontalAlignment="Center"
                          Foreground="#2b579a"
                          Margin="0,0,0,10"/>
                
                <TextBlock Text="Введите email для получения инструкций" 
                          FontSize="14" 
                          HorizontalAlignment="Center"
                          Foreground="#666"
                          Margin="0,0,0,20"
                          TextWrapping="Wrap"/>
                
                <!-- Поле email -->
                <StackPanel Spacing="5">
                    <TextBlock Text="Email" 
                              FontWeight="SemiBold"
                              FontSize="13"
                              Foreground="#333"/>
                    <TextBox Text="{Binding Email}" 
                             Height="45"
                             Padding="12,0"
                             FontSize="15"
                             Watermark="Введите ваш email"
                             Background="#FAFAFA"
                             BorderBrush="#DDD"
                             BorderThickness="1"
                             IsEnabled="{Binding !IsLoading}"/>
                </StackPanel>
                
                <!-- Сообщение об ошибке -->
                <Border Background="#FFEBEE"
                        BorderBrush="#F44336"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,8"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource StringIsNotEmptyConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" 
                              Foreground="#C62828"
                              TextWrapping="Wrap"
                              FontSize="13"/>
                </Border>
                
                <!-- Сообщение об успехе -->
                <Border Background="#E8F5E9"
                        BorderBrush="#4CAF50"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,8"
                        IsVisible="{Binding SuccessMessage, Converter={StaticResource StringIsNotEmptyConverter}}">
                    <TextBlock Text="{Binding SuccessMessage}" 
                              Foreground="#2E7D32"
                              TextWrapping="Wrap"
                              FontSize="13"/>
                </Border>
                
                <!-- Кнопка отправки -->
                <Button Content="{Binding IsLoading, Converter={StaticResource LoadingButtonConverter}}" 
                        Command="{Binding SendResetLinkCommand}" 
                        Height="50"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="#2b579a" 
                        Foreground="White"
                        BorderThickness="0"
                        CornerRadius="5"
                        Margin="0,10,0,0"
                        IsEnabled="{Binding !IsLoading}"
                        Cursor="Hand">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#1e4a7a"/>
                        </Style>
                        <Style Selector="Button:pressed">
                            <Setter Property="Background" Value="#153a5e"/>
                        </Style>
                    </Button.Styles>
                </Button>
                
                <!-- Кнопка назад -->
                <Button Content="Вернуться к входу" 
                        Command="{Binding BackToLoginCommand}" 
                        Height="40"
                        FontSize="14"
                        Background="Transparent" 
                        Foreground="#2b579a"
                        BorderThickness="0"
                        Margin="0,10,0,0"
                        Cursor="Hand"
                        IsEnabled="{Binding !IsLoading}">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Foreground" Value="#1e4a7a"/>
                        </Style>
                    </Button.Styles>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

