<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MessengerClient.ViewModels"
             x:Class="MessengerClient.Views.LoginView"
             x:DataType="vm:LoginViewModel">
    
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15" Background="White">
        <TextBlock Text="MESSENGER LOGIN" FontSize="20" FontWeight="Bold"/>
        
        <TextBlock Text="Username:" FontWeight="Bold"/>
        <TextBox Text="{Binding Username}" Width="250" Background="White" Foreground="Black"/>
        
        <TextBlock Text="Password:" FontWeight="Bold"/>
        <TextBox Text="{Binding Password}" Width="250" Background="White" Foreground="Black"/>
        
        <Button Content="LOGIN" Command="{Binding LoginCommand}" Width="120" Height="35" 
                Background="#2b579a" Foreground="White" FontWeight="Bold"/>
                
        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextAlignment="Center"/>
    </StackPanel>
</UserControl>