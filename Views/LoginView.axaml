<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MessengerClient.Views.LoginView">
    
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15" Width="300" Background="LightBlue">
        <TextBlock Text="Messenger Login" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Background="Yellow"/>
        
        <!-- Border имитирующий TextBox -->
        <Border Height="40" Background="White" BorderBrush="Black" BorderThickness="1" CornerRadius="3">
            <TextBlock Text="Email will appear here" VerticalAlignment="Center" Margin="10,0" Foreground="Gray"/>
        </Border>
        
        <Border Height="40" Background="White" BorderBrush="Black" BorderThickness="1" CornerRadius="3">
            <TextBlock Text="Password will appear here" VerticalAlignment="Center" Margin="10,0" Foreground="Gray"/>
        </Border>
        
        <Button Name="LoginBtn" Content="Login" Height="40" Background="Green" Foreground="White"
                FontWeight="Bold" HorizontalAlignment="Stretch"/>
        
        <TextBlock Name="ErrorText" Foreground="Red" TextAlignment="Center" TextWrapping="Wrap" Background="Pink"/>
    </StackPanel>
</UserControl>