<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MessengerClient.ViewModels"
             x:Class="MessengerClient.Views.ChatListView"
             x:DataType="vm:ChatListViewModel">
    
    <StackPanel Background="White">
        <!-- Header -->
        <Border Background="Blue" Padding="15">
            <TextBlock Text="MESSENGER CHATS" FontSize="18" FontWeight="Bold" Foreground="White"/>
        </Border>
        
        <!-- Прямой показ данных -->
        <TextBlock Text="{Binding Chats.Count, StringFormat='You have {0} chats:'}" 
                   Margin="10" FontWeight="Bold"/>
        
        <!-- Чат 1 -->
        <Border Background="#f0f0f0" Margin="10" Padding="10" CornerRadius="5">
            <TextBlock Text="{Binding Chats[0].Name}" FontWeight="Bold"/>
        </Border>
        
        <!-- Чат 2 -->
        <Border Background="#f0f0f0" Margin="10" Padding="10" CornerRadius="5">
            <TextBlock Text="{Binding Chats[1].Name}" FontWeight="Bold"/>
        </Border>
        
        <!-- Чат 3 -->
        <Border Background="#f0f0f0" Margin="10" Padding="10" CornerRadius="5">
            <TextBlock Text="{Binding Chats[2].Name}" FontWeight="Bold"/>
        </Border>
        
        <!-- Чат 4 -->
        <Border Background="#f0f0f0" Margin="10" Padding="10" CornerRadius="5">
            <TextBlock Text="{Binding Chats[3].Name}" FontWeight="Bold"/>
        </Border>
        
        <!-- Кнопки -->
        <StackPanel Margin="20" Spacing="10">
            <Button Content="Test Chat 1" Background="Green" Foreground="White" Padding="10"
                    Click="OpenChat1_Click"/>
            <Button Content="Logout" Command="{Binding LogoutCommand}" 
                    Background="Red" Foreground="White" Padding="10"/>
        </StackPanel>
    </StackPanel>
</UserControl>