<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MessengerClient.Views.ChatListView">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2b579a" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Messenger" FontSize="18" FontWeight="Bold" Foreground="White"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Name="ProfileBtn" Content="👤 Profile" Background="Transparent" Foreground="White" 
                            BorderThickness="0" FontSize="14"/>
                    <Button Name="LogoutBtn" Content="Logout" Padding="10,5" Background="#e74c3c" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chat List -->
        <ScrollViewer Grid.Row="1" Margin="10">
            <StackPanel Name="ChatsPanel">
                <!-- Чаты будут добавляться через код -->
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#f8f9fa" Padding="10">
            <TextBlock Name="ChatsCountText" Text="0 chats" FontStyle="Italic" Foreground="#666"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>