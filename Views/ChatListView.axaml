<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MessengerClient.Views.ChatListView">
    
    <Grid Background="White" Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2b579a" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Messenger" FontSize="18" FontWeight="Bold" Foreground="White"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <TextBlock Name="UsernameText" Text="User" Foreground="White" VerticalAlignment="Center"/>
                    <Button Name="ProfileBtn" Content="Profile" Margin="0,0,10,0" Padding="10,5" 
                            Background="#3498db" Foreground="White"/>
                    <Button Name="LogoutBtn" Content="Logout" Padding="10,5" 
                            Background="#e74c3c" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search Bar -->
        <Border Grid.Row="1" Background="#f8f9fa" Padding="10" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1">
            <TextBox Text="{Binding SearchText}" 
                    Watermark="Поиск по контактам..."
                    Height="40"
                    Padding="15,0"
                    Background="White"
                    BorderBrush="#DDD"
                    BorderThickness="1"/>
        </Border>

        <!-- Chat List -->
        <ScrollViewer Grid.Row="2" Margin="10">
            <StackPanel Name="ChatsPanel">
                <!-- Чаты будут добавляться через код -->
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#f8f9fa" Padding="10">
            <TextBlock Name="ChatsCountText" Text="0 chats" FontStyle="Italic" Foreground="#666"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>