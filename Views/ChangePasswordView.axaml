<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MessengerClient.ViewModels"
             x:Class="MessengerClient.Views.ChangePasswordView"
             x:DataType="vm:ChangePasswordViewModel">
    
    <Grid Background="#F5F5F5">
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="10"
                BoxShadow="0 4 6 0 #00000020"
                Padding="40"
                MinWidth="400"
                MaxWidth="450">
            <StackPanel Spacing="20">
                <!-- Заголовок -->
                <TextBlock Text="Смена пароля" 
                          FontSize="28" 
                          FontWeight="Bold" 
                          HorizontalAlignment="Center"
                          Foreground="#2b579a"
                          Margin="0,0,0,10"/>
                
                <!-- Текущий пароль -->
                <StackPanel Spacing="5">
                    <TextBlock Text="Текущий пароль" 
                              FontWeight="SemiBold"
                              FontSize="13"
                              Foreground="#333"/>
                    <TextBox Text="{Binding CurrentPassword}" 
                             Height="45"
                             Padding="12,0"
                             FontSize="15"
                             Watermark="Введите текущий пароль"
                             Background="White"
                             BorderBrush="#DDD"
                             BorderThickness="1"
                             IsEnabled="{Binding !IsLoading}"/>
                </StackPanel>
                
                <!-- Новый пароль -->
                <StackPanel Spacing="5">
                    <TextBlock Text="Новый пароль" 
                              FontWeight="SemiBold"
                              FontSize="13"
                              Foreground="#333"/>
                    <TextBox Text="{Binding NewPassword}" 
                             Height="45"
                             Padding="12,0"
                             FontSize="15"
                             Watermark="Введите новый пароль"
                             Background="White"
                             BorderBrush="#DDD"
                             BorderThickness="1"
                             IsEnabled="{Binding !IsLoading}"/>
                </StackPanel>
                
                <!-- Подтверждение пароля -->
                <StackPanel Spacing="5">
                    <TextBlock Text="Подтвердите пароль" 
                              FontWeight="SemiBold"
                              FontSize="13"
                              Foreground="#333"/>
                    <TextBox Text="{Binding ConfirmPassword}" 
                             Height="45"
                             Padding="12,0"
                             FontSize="15"
                             Watermark="Повторите новый пароль"
                             Background="White"
                             BorderBrush="#DDD"
                             BorderThickness="1"
                             IsEnabled="{Binding !IsLoading}"/>
                </StackPanel>
                
                <!-- Сообщение об ошибке -->
                <Border Background="#FFEBEE"
                        BorderBrush="#F44336"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,8"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource StringIsNotEmptyConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" 
                              Foreground="#C62828"
                              TextWrapping="Wrap"
                              FontSize="13"/>
                </Border>
                
                <!-- Сообщение об успехе -->
                <Border Background="#E8F5E9"
                        BorderBrush="#4CAF50"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,8"
                        IsVisible="{Binding SuccessMessage, Converter={StaticResource StringIsNotEmptyConverter}}">
                    <TextBlock Text="{Binding SuccessMessage}" 
                              Foreground="#2E7D32"
                              TextWrapping="Wrap"
                              FontSize="13"/>
                </Border>
                
                <!-- Кнопки -->
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Center" 
                           Spacing="15"
                           Margin="0,10,0,0">
                    <Button Command="{Binding CancelCommand}" 
                           Height="45"
                           Width="120"
                           FontSize="14"
                           Background="Transparent" 
                           Foreground="#2b579a"
                           BorderBrush="#DDD"
                           BorderThickness="1"
                           IsEnabled="{Binding !IsLoading}"
                           Cursor="Hand"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center">
                        <TextBlock Text="Отмена" 
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Button>
                    
                    <Button Command="{Binding ChangePasswordCommand}" 
                           Height="45"
                           Width="120"
                           FontSize="14"
                           FontWeight="Bold"
                           Background="#2b579a" 
                           Foreground="White"
                           BorderThickness="0"
                           CornerRadius="5"
                           IsEnabled="{Binding !IsLoading}"
                           Cursor="Hand"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center">
                        <TextBlock Text="{Binding IsLoading, Converter={StaticResource LoadingButtonConverter}}" 
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#1e4a7a"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

