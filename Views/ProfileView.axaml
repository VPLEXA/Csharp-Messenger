<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MessengerClient.Views.ProfileView">
    
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15" Width="300">
        <TextBlock Text="Profile (Coming Soon)" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
        <Button Name="BackBtn" Content="← Back to Chats" Height="40" Background="#2b579a" Foreground="White"
                FontWeight="Bold" HorizontalAlignment="Stretch"/>
    </StackPanel>
</UserControl>